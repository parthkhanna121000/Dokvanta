# New TypeScript backend (v2). The legacy backend keeps using PORT and MONGODB_URI.
NODE_ENV=development
API_PORT=5001
# Must point to a DIFFERENT database than MONGODB_URI (use the name dokvanta_v2).
V2_MONGODB_URI=mongodb://127.0.0.1:27017/dokvanta_v2
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Auth + file storage (v2)
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800
STORAGE_DIR=storage
MAX_UPLOAD_MB=25

# AI provider: "mock" is a rule-based stand-in (dev/tests only). "gemini" needs GEMINI_API_KEY.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=30000